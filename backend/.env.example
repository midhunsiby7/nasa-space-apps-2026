# ==============================================================================
# COSMOLOOKUP Backend Environment Configuration Example
# Copy to .env and adjust values for your local environment
# ==============================================================================

# Application Metadata
PROJECT_NAME="COSMOLOOKUP API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration (Default: local SQLite database file inside backend)
DATABASE_URL="sqlite:///./cosmolookup.db"

# CORS Configuration (Comma-separated origins allowed to make API requests)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
